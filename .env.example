# Copy to .env.local. Set only the optional path you want to run.
PAYMENTLAB_WORKFLOW_BUILD_MODE=protected-deny

# LM Studio suggestion in /simulation; also used by /local-sandbox.
PAYMENTLAB_ENVIRONMENT=
PAYMENTLAB_STUDIO_LOCAL_MODEL_ENABLE=
PAYMENTLAB_LOCAL_MODEL_URL=http://127.0.0.1:1234
PAYMENTLAB_LOCAL_MODEL_ID=
# LM_STUDIO_API_TOKEN=              # Only if you enabled LM Studio authentication.

# Live local A2A journey. For file storage, make a private 0700 absolute directory.
PAYMENTLAB_LOCAL_DEMO_ENABLE=
PAYMENTLAB_LOCAL_DEMO_STORE=file
PAYMENTLAB_LOCAL_DEMO_STATE_DIR=

# Optional local PostgreSQL for durable Studio or local A2A journey.
PAYMENTLAB_DATABASE_MODE=
PAYMENTLAB_STUDIO_DURABLE_ENABLE=
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE

# Optional Stripe sandbox; leave disabled for scripted/model-only runs.
PAYMENTLAB_LOCAL_STRIPE_PAYMENT_ENABLE=
PAYMENTLAB_STRIPE_ACCOUNT_ID=
STRIPE_SECRET_KEY=
PAYMENTLAB_LOCAL_WEBHOOK_ENABLE=
STRIPE_WEBHOOK_SECRET=
